+// Lab 3 helper: delays a memory response (valid, rdata, error) by N clock
+// cycles. N = 0 is a pure wire, so the default keeps the original behavior.
+// Only valid for a responder without back-pressure that answers in order,
+// which is the case for the PULPissimo L2 (r_valid one cycle after gnt).
+module fc_resp_delay #(
+  parameter int unsigned N = 0
+) (
+  input  logic        clk_i,
+  input  logic        rst_ni,
+  input  logic        valid_i,
+  input  logic [31:0] rdata_i,
+  input  logic        err_i,
+  output logic        valid_o,
+  output logic [31:0] rdata_o,
+  output logic        err_o
+);
+
+  if (N == 0) begin : gen_bypass
+    assign valid_o = valid_i;
+    assign rdata_o = rdata_i;
+    assign err_o   = err_i;
+  end else begin : gen_delay
+    logic [N-1:0]       valid_q;
+    logic [N-1:0][31:0] rdata_q;
+    logic [N-1:0]       err_q;
+
+    always_ff @(posedge clk_i or negedge rst_ni) begin
+      if (!rst_ni) begin
+        valid_q <= '0;
+        rdata_q <= '0;
+        err_q   <= '0;
+      end else begin
+        valid_q[0] <= valid_i;
+        rdata_q[0] <= rdata_i;
+        err_q[0]   <= err_i;
+        for (int i = 1; i < N; i++) begin
+          valid_q[i] <= valid_q[i-1];
+          rdata_q[i] <= rdata_q[i-1];
+          err_q[i]   <= err_q[i-1];
+        end
+      end
+    end
+
+    assign valid_o = valid_q[N-1];
+    assign rdata_o = rdata_q[N-1];
+    assign err_o   = err_q[N-1];
+  end
+
+endmodule
